# Do not use Firebase credentials here. This is a new, separate PostgreSQL database.
DATABASE_URL=postgresql://dineos_app:change_me@localhost:5432/dineos_next
PORT=4000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGINS=http://localhost:5173
# Same project as the frontend. Public/publishable key, NEVER a service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Keep false until migration 029, SMTP, templates and real delivery are verified.
MEMBER_EMAIL_OTP_ENABLED=false
# Test mode must name the single inbox you control. Do not use customer emails.
# Supabase default Auth email only reaches authorized project team recipients.
MEMBER_EMAIL_MODE=test
MEMBER_EMAIL_TEST_RECIPIENT=
# Server-only welcome email delivery. Keep false until migration 033 and real
# inbox testing are approved. Never use VITE_ names for these credentials.
MEMBER_WELCOME_EMAIL_ENABLED=false
MEMBER_EMAIL_FROM=DineOS <onboarding@resend.dev>
RESEND_API_KEY=
